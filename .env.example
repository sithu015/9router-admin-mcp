# Base URL for your 9router instance
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128

# Auth mode: none | bearer | apiKey | both
NINE_ROUTER_AUTH_MODE=none

# Optional credentials if your deployment enables auth
NINE_ROUTER_BEARER_TOKEN=
NINE_ROUTER_API_KEY=

# Request timeout in milliseconds
NINE_ROUTER_TIMEOUT_MS=15000
